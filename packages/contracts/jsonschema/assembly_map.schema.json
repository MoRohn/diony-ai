{
  "$defs": {
    "AssemblyEvent": {
      "properties": {
        "clip_id": {
          "title": "Clip Id",
          "type": "string"
        },
        "op_id": {
          "default": "",
          "title": "Op Id",
          "type": "string"
        },
        "in_s": {
          "default": 0,
          "minimum": 0,
          "title": "In S",
          "type": "number"
        },
        "out_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Out S"
        },
        "join": {
          "default": "cut",
          "enum": [
            "cut",
            "xfade"
          ],
          "title": "Join",
          "type": "string"
        }
      },
      "required": [
        "clip_id"
      ],
      "title": "AssemblyEvent",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/AssemblyEvent"
      },
      "title": "Events",
      "type": "array"
    },
    "loudness_target": {
      "default": "streaming",
      "enum": [
        "broadcast",
        "streaming"
      ],
      "title": "Loudness Target",
      "type": "string"
    },
    "look": {
      "default": "diony-default",
      "title": "Look",
      "type": "string"
    },
    "title": {
      "default": "",
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "id"
  ],
  "title": "AssemblyMap",
  "type": "object"
}
