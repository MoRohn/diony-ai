{
  "$defs": {
    "ProductionStopDisposition": {
      "enum": [
        "keep",
        "delete"
      ],
      "title": "ProductionStopDisposition",
      "type": "string"
    },
    "ProductionStopReceipt": {
      "description": "Durable user decision for a manually stopped Production run.",
      "properties": {
        "disposition": {
          "$ref": "#/$defs/ProductionStopDisposition"
        },
        "stopped_at": {
          "format": "date-time",
          "title": "Stopped At",
          "type": "string"
        },
        "completed_take_ids": {
          "items": {
            "type": "string"
          },
          "title": "Completed Take Ids",
          "type": "array"
        },
        "result_path": {
          "default": "",
          "title": "Result Path",
          "type": "string"
        },
        "result_sha256": {
          "default": "",
          "title": "Result Sha256",
          "type": "string"
        },
        "result_width": {
          "default": 0,
          "minimum": 0,
          "title": "Result Width",
          "type": "integer"
        },
        "result_height": {
          "default": 0,
          "minimum": 0,
          "title": "Result Height",
          "type": "integer"
        },
        "deleted_file_count": {
          "default": 0,
          "minimum": 0,
          "title": "Deleted File Count",
          "type": "integer"
        },
        "result_error": {
          "default": "",
          "title": "Result Error",
          "type": "string"
        }
      },
      "required": [
        "disposition"
      ],
      "title": "ProductionStopReceipt",
      "type": "object"
    }
  },
  "description": "Audit receipt for a new immutable take set on the same stopped Project.",
  "properties": {
    "restarted_at": {
      "format": "date-time",
      "title": "Restarted At",
      "type": "string"
    },
    "reason": {
      "default": "reference_and_performance_recalibration",
      "title": "Reason",
      "type": "string"
    },
    "previous_project_version": {
      "minimum": 1,
      "title": "Previous Project Version",
      "type": "integer"
    },
    "new_project_version": {
      "minimum": 2,
      "title": "New Project Version",
      "type": "integer"
    },
    "previous_stop": {
      "$ref": "#/$defs/ProductionStopReceipt"
    },
    "preserved_take_ids": {
      "items": {
        "type": "string"
      },
      "title": "Preserved Take Ids",
      "type": "array"
    },
    "replacement_take_ids": {
      "items": {
        "type": "string"
      },
      "title": "Replacement Take Ids",
      "type": "array"
    },
    "prompt_strategy_version": {
      "title": "Prompt Strategy Version",
      "type": "string"
    },
    "reference_asset_ids": {
      "items": {
        "type": "string"
      },
      "title": "Reference Asset Ids",
      "type": "array"
    }
  },
  "required": [
    "previous_project_version",
    "new_project_version",
    "previous_stop",
    "prompt_strategy_version"
  ],
  "title": "ProductionRestartReceipt",
  "type": "object"
}
