{
  "$defs": {
    "ReviewVerdict": {
      "enum": [
        "strong",
        "acceptable",
        "revise",
        "fail"
      ],
      "title": "ReviewVerdict",
      "type": "string"
    }
  },
  "description": "Structural variety of a rundown before any GPU time is spent.",
  "properties": {
    "version": {
      "default": "diony-rundown-review-v1",
      "title": "Version",
      "type": "string"
    },
    "shot_count": {
      "minimum": 0,
      "title": "Shot Count",
      "type": "integer"
    },
    "score": {
      "maximum": 5,
      "minimum": 0,
      "title": "Score",
      "type": "number"
    },
    "verdict": {
      "$ref": "#/$defs/ReviewVerdict"
    },
    "violations": {
      "items": {
        "type": "string"
      },
      "title": "Violations",
      "type": "array"
    },
    "suggestions": {
      "items": {
        "type": "string"
      },
      "title": "Suggestions",
      "type": "array"
    },
    "waived": {
      "items": {
        "type": "string"
      },
      "title": "Waived",
      "type": "array"
    },
    "shot_sizes": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Shot Sizes",
      "type": "object"
    },
    "static_ratio": {
      "default": 0.0,
      "maximum": 1,
      "minimum": 0,
      "title": "Static Ratio",
      "type": "number"
    },
    "lighting_keys": {
      "default": 0,
      "minimum": 0,
      "title": "Lighting Keys",
      "type": "integer"
    },
    "hero_count": {
      "default": 0,
      "minimum": 0,
      "title": "Hero Count",
      "type": "integer"
    },
    "reviewed_at": {
      "format": "date-time",
      "title": "Reviewed At",
      "type": "string"
    }
  },
  "required": [
    "shot_count",
    "score",
    "verdict"
  ],
  "title": "RundownReview",
  "type": "object"
}
