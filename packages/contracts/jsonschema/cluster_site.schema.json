{
  "$defs": {
    "ComputePath": {
      "enum": [
        "local",
        "dual",
        "lease",
        "b300",
        "b200"
      ],
      "title": "ComputePath",
      "type": "string"
    }
  },
  "description": "Where Diony compute lives. Local Quad-Spark is the SKU. Dual-Spark, B300, and B200 are signed lease exceptions.",
  "properties": {
    "path": {
      "$ref": "#/$defs/ComputePath",
      "default": "local"
    },
    "profile": {
      "default": "spark-4x-v1",
      "title": "Profile",
      "type": "string"
    },
    "provider": {
      "default": "",
      "title": "Provider",
      "type": "string"
    },
    "gpu_class": {
      "default": "",
      "title": "Gpu Class",
      "type": "string"
    },
    "exception_by": {
      "default": "",
      "title": "Exception By",
      "type": "string"
    },
    "exception_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Exception At"
    }
  },
  "title": "ClusterSite",
  "type": "object"
}
