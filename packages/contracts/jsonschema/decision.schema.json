{
  "$defs": {
    "DecisionCategory": {
      "enum": [
        "coverage",
        "lane_selection",
        "seed_selection",
        "casting",
        "retake",
        "settle",
        "hero_select",
        "soundtrack",
        "look",
        "fallback",
        "final_review",
        "sizing"
      ],
      "title": "DecisionCategory",
      "type": "string"
    },
    "DecisionOption": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "score": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "reason": {
          "default": "",
          "title": "Reason",
          "type": "string"
        },
        "rejected_because": {
          "default": "",
          "title": "Rejected Because",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "title": "DecisionOption",
      "type": "object"
    }
  },
  "description": "One production choice with the options it was chosen from.\n\nAppend-only. Re-deciding a subject appends a new entry; the earlier entry\nis history, never rewritten. `confidence` is the recorder's own estimate\nand is never 1.0 for a heuristic choice.",
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "at": {
      "format": "date-time",
      "title": "At",
      "type": "string"
    },
    "stage": {
      "title": "Stage",
      "type": "string"
    },
    "category": {
      "$ref": "#/$defs/DecisionCategory"
    },
    "subject": {
      "title": "Subject",
      "type": "string"
    },
    "options": {
      "items": {
        "$ref": "#/$defs/DecisionOption"
      },
      "minItems": 1,
      "title": "Options",
      "type": "array"
    },
    "selected": {
      "title": "Selected",
      "type": "string"
    },
    "reason": {
      "title": "Reason",
      "type": "string"
    },
    "confidence": {
      "default": 0.7,
      "maximum": 1,
      "minimum": 0,
      "title": "Confidence",
      "type": "number"
    },
    "shot_id": {
      "default": "",
      "title": "Shot Id",
      "type": "string"
    },
    "take_id": {
      "default": "",
      "title": "Take Id",
      "type": "string"
    },
    "user_visible": {
      "default": true,
      "title": "User Visible",
      "type": "boolean"
    },
    "user_approved": {
      "default": false,
      "title": "User Approved",
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "stage",
    "category",
    "subject",
    "options",
    "selected",
    "reason"
  ],
  "title": "Decision",
  "type": "object"
}
