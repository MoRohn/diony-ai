{
  "$defs": {
    "AudioSpotcheck": {
      "properties": {
        "dialogue_expected": {
          "default": false,
          "title": "Dialogue Expected",
          "type": "boolean"
        },
        "dialogue_present": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dialogue Present"
        },
        "measured_lufs": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Measured Lufs"
        },
        "true_peak_dbtp": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "True Peak Dbtp"
        },
        "target_lufs": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Lufs"
        },
        "silent": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Silent"
        },
        "clipping": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clipping"
        },
        "issues": {
          "items": {
            "type": "string"
          },
          "title": "Issues",
          "type": "array"
        }
      },
      "title": "AudioSpotcheck",
      "type": "object"
    },
    "PromisePreservation": {
      "properties": {
        "target_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Seconds"
        },
        "delivered_seconds": {
          "default": 0.0,
          "minimum": 0,
          "title": "Delivered Seconds",
          "type": "number"
        },
        "duration_ok": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Ok"
        },
        "fps_ok": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fps Ok"
        },
        "loudness_ok": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Loudness Ok"
        },
        "motion_ratio": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Motion Ratio"
        },
        "motion_ok": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Motion Ok"
        },
        "settled_prints": {
          "default": 0,
          "minimum": 0,
          "title": "Settled Prints",
          "type": "integer"
        },
        "failed_prints": {
          "default": 0,
          "minimum": 0,
          "title": "Failed Prints",
          "type": "integer"
        },
        "issues": {
          "items": {
            "type": "string"
          },
          "title": "Issues",
          "type": "array"
        }
      },
      "title": "PromisePreservation",
      "type": "object"
    },
    "RecommendedAction": {
      "enum": [
        "present_to_user",
        "re_render",
        "retake",
        "block",
        "skipped"
      ],
      "title": "RecommendedAction",
      "type": "string"
    },
    "ReviewStatus": {
      "enum": [
        "pass",
        "revise",
        "fail",
        "skipped"
      ],
      "title": "ReviewStatus",
      "type": "string"
    },
    "SubtitleCheck": {
      "properties": {
        "expected": {
          "default": false,
          "title": "Expected",
          "type": "boolean"
        },
        "present": {
          "default": false,
          "title": "Present",
          "type": "boolean"
        },
        "cue_count": {
          "default": 0,
          "minimum": 0,
          "title": "Cue Count",
          "type": "integer"
        },
        "issues": {
          "items": {
            "type": "string"
          },
          "title": "Issues",
          "type": "array"
        }
      },
      "title": "SubtitleCheck",
      "type": "object"
    },
    "TechnicalProbe": {
      "properties": {
        "valid_container": {
          "default": false,
          "title": "Valid Container",
          "type": "boolean"
        },
        "width": {
          "default": 0,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "default": 0,
          "title": "Height",
          "type": "integer"
        },
        "fps": {
          "default": 0.0,
          "title": "Fps",
          "type": "number"
        },
        "duration_seconds": {
          "default": 0.0,
          "title": "Duration Seconds",
          "type": "number"
        },
        "frames": {
          "default": 0,
          "title": "Frames",
          "type": "integer"
        },
        "has_audio": {
          "default": false,
          "title": "Has Audio",
          "type": "boolean"
        },
        "codec": {
          "default": "",
          "title": "Codec",
          "type": "string"
        },
        "pix_fmt": {
          "default": "",
          "title": "Pix Fmt",
          "type": "string"
        },
        "issues": {
          "items": {
            "type": "string"
          },
          "title": "Issues",
          "type": "array"
        }
      },
      "title": "TechnicalProbe",
      "type": "object"
    },
    "VisualSpotcheck": {
      "properties": {
        "frames_sampled": {
          "default": 0,
          "minimum": 0,
          "title": "Frames Sampled",
          "type": "integer"
        },
        "black_frames": {
          "default": 0,
          "minimum": 0,
          "title": "Black Frames",
          "type": "integer"
        },
        "low_sharpness_frames": {
          "default": 0,
          "minimum": 0,
          "title": "Low Sharpness Frames",
          "type": "integer"
        },
        "exposure_issues": {
          "default": 0,
          "minimum": 0,
          "title": "Exposure Issues",
          "type": "integer"
        },
        "sharpness_min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sharpness Min"
        },
        "issues": {
          "items": {
            "type": "string"
          },
          "title": "Issues",
          "type": "array"
        }
      },
      "title": "VisualSpotcheck",
      "type": "object"
    }
  },
  "description": "What the program master measured after mix, before it is called done.",
  "properties": {
    "version": {
      "default": "diony-final-review-v1",
      "title": "Version",
      "type": "string"
    },
    "timeline_id": {
      "default": "",
      "title": "Timeline Id",
      "type": "string"
    },
    "master_path": {
      "default": "",
      "title": "Master Path",
      "type": "string"
    },
    "master_sha256": {
      "default": "",
      "pattern": "^(?:|[0-9a-f]{64})$",
      "title": "Master Sha256",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ReviewStatus"
    },
    "recommended_action": {
      "$ref": "#/$defs/RecommendedAction"
    },
    "technical_probe": {
      "$ref": "#/$defs/TechnicalProbe"
    },
    "visual_spotcheck": {
      "$ref": "#/$defs/VisualSpotcheck"
    },
    "audio_spotcheck": {
      "$ref": "#/$defs/AudioSpotcheck"
    },
    "promise_preservation": {
      "$ref": "#/$defs/PromisePreservation"
    },
    "subtitle_check": {
      "$ref": "#/$defs/SubtitleCheck"
    },
    "issues_found": {
      "items": {
        "type": "string"
      },
      "title": "Issues Found",
      "type": "array"
    },
    "offending_shot_ids": {
      "items": {
        "type": "string"
      },
      "title": "Offending Shot Ids",
      "type": "array"
    },
    "remediation": {
      "default": "",
      "title": "Remediation",
      "type": "string"
    },
    "reviewed_at": {
      "format": "date-time",
      "title": "Reviewed At",
      "type": "string"
    }
  },
  "required": [
    "status",
    "recommended_action"
  ],
  "title": "FinalReview",
  "type": "object"
}
