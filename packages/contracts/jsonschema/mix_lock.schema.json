{
  "$defs": {
    "AlignedCut": {
      "properties": {
        "cut_seconds": {
          "minimum": 0,
          "title": "Cut Seconds",
          "type": "number"
        },
        "downbeat_seconds": {
          "minimum": 0,
          "title": "Downbeat Seconds",
          "type": "number"
        },
        "error_ms": {
          "minimum": 0,
          "title": "Error Ms",
          "type": "number"
        },
        "grid": {
          "default": "downbeat",
          "title": "Grid",
          "type": "string"
        }
      },
      "required": [
        "cut_seconds",
        "downbeat_seconds",
        "error_ms"
      ],
      "title": "AlignedCut",
      "type": "object"
    },
    "AlignmentMode": {
      "enum": [
        "beat_cut",
        "phrase_flow",
        "unaligned"
      ],
      "title": "AlignmentMode",
      "type": "string"
    },
    "LoudnessTarget": {
      "enum": [
        "broadcast",
        "streaming"
      ],
      "title": "LoudnessTarget",
      "type": "string"
    },
    "MixLockState": {
      "enum": [
        "open",
        "locked"
      ],
      "title": "MixLockState",
      "type": "string"
    },
    "ScoreAlignment": {
      "description": "One score cue's placement decision against the cuts it plays under.",
      "properties": {
        "cue_id": {
          "title": "Cue Id",
          "type": "string"
        },
        "role": {
          "default": "score",
          "title": "Role",
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/AlignmentMode"
        },
        "cue_start_seconds": {
          "minimum": 0,
          "title": "Cue Start Seconds",
          "type": "number"
        },
        "cue_duration_seconds": {
          "exclusiveMinimum": 0,
          "title": "Cue Duration Seconds",
          "type": "number"
        },
        "source_shift_seconds": {
          "default": 0.0,
          "minimum": 0,
          "title": "Source Shift Seconds",
          "type": "number"
        },
        "hero_cut_seconds": {
          "items": {
            "type": "number"
          },
          "title": "Hero Cut Seconds",
          "type": "array"
        },
        "aligned_cuts": {
          "items": {
            "$ref": "#/$defs/AlignedCut"
          },
          "title": "Aligned Cuts",
          "type": "array"
        },
        "missed_cuts": {
          "default": 0,
          "minimum": 0,
          "title": "Missed Cuts",
          "type": "integer"
        },
        "max_error_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Error Ms"
        },
        "bpm": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bpm"
        },
        "reason": {
          "default": "",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "cue_id",
        "mode",
        "cue_start_seconds",
        "cue_duration_seconds"
      ],
      "title": "ScoreAlignment",
      "type": "object"
    }
  },
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/MixLockState",
      "default": "open"
    },
    "loudness": {
      "$ref": "#/$defs/LoudnessTarget",
      "default": "broadcast"
    },
    "measured_lufs": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Measured Lufs"
    },
    "true_peak_dbtp": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "True Peak Dbtp"
    },
    "stem_asset_ids": {
      "items": {
        "type": "string"
      },
      "title": "Stem Asset Ids",
      "type": "array"
    },
    "picture_lock_timeline_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Picture Lock Timeline Id"
    },
    "picture_only": {
      "default": false,
      "title": "Picture Only",
      "type": "boolean"
    },
    "policy": {
      "default": "",
      "title": "Policy",
      "type": "string"
    },
    "score_alignments": {
      "items": {
        "$ref": "#/$defs/ScoreAlignment"
      },
      "title": "Score Alignments",
      "type": "array"
    },
    "audio_layout": {
      "default": "stereo",
      "title": "Audio Layout",
      "type": "string"
    },
    "surround_stem_asset_id": {
      "default": "",
      "title": "Surround Stem Asset Id",
      "type": "string"
    },
    "surround_measured_lufs": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Surround Measured Lufs"
    },
    "surround_true_peak_dbtp": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Surround True Peak Dbtp"
    }
  },
  "required": [
    "id"
  ],
  "title": "MixLock",
  "type": "object"
}
