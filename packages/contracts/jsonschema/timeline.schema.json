{
  "$defs": {
    "PictureLockState": {
      "enum": [
        "open",
        "locked"
      ],
      "title": "PictureLockState",
      "type": "string"
    },
    "TimelineEvent": {
      "properties": {
        "shot_id": {
          "title": "Shot Id",
          "type": "string"
        },
        "start_frame": {
          "title": "Start Frame",
          "type": "integer"
        },
        "handle_in": {
          "default": 0,
          "title": "Handle In",
          "type": "integer"
        },
        "handle_out": {
          "default": 0,
          "title": "Handle Out",
          "type": "integer"
        },
        "take_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Take Id"
        },
        "overlap_frames": {
          "default": 8,
          "title": "Overlap Frames",
          "type": "integer"
        },
        "keyframe_from_take_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Keyframe From Take Id"
        }
      },
      "required": [
        "shot_id",
        "start_frame"
      ],
      "title": "TimelineEvent",
      "type": "object"
    }
  },
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/TimelineEvent"
      },
      "title": "Events",
      "type": "array"
    },
    "picture_lock": {
      "$ref": "#/$defs/PictureLockState",
      "default": "open"
    },
    "total_frames": {
      "default": 0,
      "title": "Total Frames",
      "type": "integer"
    },
    "fps": {
      "default": 23.976,
      "title": "Fps",
      "type": "number"
    },
    "preview_path": {
      "default": "",
      "title": "Preview Path",
      "type": "string"
    },
    "picture_sha256": {
      "default": "",
      "title": "Picture Sha256",
      "type": "string"
    },
    "program_sha256": {
      "default": "",
      "title": "Program Sha256",
      "type": "string"
    },
    "source_artifact_sha256s": {
      "items": {
        "type": "string"
      },
      "title": "Source Artifact Sha256S",
      "type": "array"
    },
    "stitched": {
      "default": false,
      "title": "Stitched",
      "type": "boolean"
    },
    "gallery_removed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Gallery Removed At"
    }
  },
  "required": [
    "id"
  ],
  "title": "Timeline",
  "type": "object"
}
