{
  "$defs": {
    "EmotionPerformance": {
      "properties": {
        "emotion": {
          "title": "Emotion",
          "type": "string"
        },
        "intensity_curve": {
          "items": {
            "type": "number"
          },
          "title": "Intensity Curve",
          "type": "array"
        },
        "rate_multiplier": {
          "default": 1.0,
          "maximum": 1.8,
          "minimum": 0.5,
          "title": "Rate Multiplier",
          "type": "number"
        },
        "pitch_shift_semitones": {
          "default": 0.0,
          "maximum": 12,
          "minimum": -12,
          "title": "Pitch Shift Semitones",
          "type": "number"
        },
        "timbre": {
          "default": "profile-locked",
          "title": "Timbre",
          "type": "string"
        }
      },
      "required": [
        "emotion"
      ],
      "title": "EmotionPerformance",
      "type": "object"
    },
    "ProsodySignature": {
      "properties": {
        "pitch_floor_hz": {
          "default": 90.0,
          "exclusiveMaximum": 1000,
          "exclusiveMinimum": 20,
          "title": "Pitch Floor Hz",
          "type": "number"
        },
        "pitch_ceiling_hz": {
          "default": 300.0,
          "exclusiveMaximum": 1500,
          "exclusiveMinimum": 20,
          "title": "Pitch Ceiling Hz",
          "type": "number"
        },
        "speaking_rate_syllables_per_second": {
          "default": 4.0,
          "exclusiveMaximum": 12,
          "exclusiveMinimum": 0.5,
          "title": "Speaking Rate Syllables Per Second",
          "type": "number"
        },
        "breath_interval_seconds": {
          "default": 5.0,
          "exclusiveMaximum": 30,
          "exclusiveMinimum": 0.5,
          "title": "Breath Interval Seconds",
          "type": "number"
        },
        "vocal_fry": {
          "default": 0.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Vocal Fry",
          "type": "number"
        },
        "pause_bias": {
          "default": 0.5,
          "maximum": 1,
          "minimum": 0,
          "title": "Pause Bias",
          "type": "number"
        },
        "breath_texture": {
          "default": "natural, controlled",
          "title": "Breath Texture",
          "type": "string"
        }
      },
      "title": "ProsodySignature",
      "type": "object"
    },
    "VoiceProfileSource": {
      "enum": [
        "zero_shot",
        "few_shot",
        "synthetic"
      ],
      "title": "VoiceProfileSource",
      "type": "string"
    },
    "VoiceReferenceSample": {
      "properties": {
        "asset_id": {
          "title": "Asset Id",
          "type": "string"
        },
        "duration_seconds": {
          "maximum": 30.0,
          "minimum": 0.1,
          "title": "Duration Seconds",
          "type": "number"
        },
        "emotion": {
          "default": "neutral",
          "title": "Emotion",
          "type": "string"
        },
        "transcript": {
          "default": "",
          "title": "Transcript",
          "type": "string"
        },
        "embedding": {
          "items": {
            "type": "number"
          },
          "maxItems": 4096,
          "minItems": 2,
          "title": "Embedding",
          "type": "array"
        },
        "embedding_model": {
          "title": "Embedding Model",
          "type": "string"
        },
        "sha256": {
          "maxLength": 64,
          "minLength": 64,
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "asset_id",
        "duration_seconds",
        "embedding",
        "embedding_model",
        "sha256"
      ],
      "title": "VoiceReferenceSample",
      "type": "object"
    }
  },
  "description": "One immutable, project-scoped voice identity revision.",
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "character_id": {
      "title": "Character Id",
      "type": "string"
    },
    "identity_lineage_id": {
      "default": "",
      "title": "Identity Lineage Id",
      "type": "string"
    },
    "version": {
      "default": 1,
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    },
    "parent_profile_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Profile Id"
    },
    "source": {
      "$ref": "#/$defs/VoiceProfileSource"
    },
    "reference_samples": {
      "items": {
        "$ref": "#/$defs/VoiceReferenceSample"
      },
      "maxItems": 16,
      "title": "Reference Samples",
      "type": "array"
    },
    "speaker_embedding_model": {
      "title": "Speaker Embedding Model",
      "type": "string"
    },
    "speaker_embedding": {
      "items": {
        "type": "number"
      },
      "maxItems": 4096,
      "minItems": 2,
      "title": "Speaker Embedding",
      "type": "array"
    },
    "prosody": {
      "$ref": "#/$defs/ProsodySignature"
    },
    "emotion_map": {
      "items": {
        "$ref": "#/$defs/EmotionPerformance"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Emotion Map",
      "type": "array"
    },
    "age_descriptor": {
      "default": "",
      "title": "Age Descriptor",
      "type": "string"
    },
    "gender_descriptor": {
      "default": "",
      "title": "Gender Descriptor",
      "type": "string"
    },
    "accent_descriptor": {
      "default": "",
      "title": "Accent Descriptor",
      "type": "string"
    },
    "texture_descriptor": {
      "default": "",
      "title": "Texture Descriptor",
      "type": "string"
    },
    "seed": {
      "title": "Seed",
      "type": "integer"
    },
    "style_lock": {
      "title": "Style Lock",
      "type": "string"
    },
    "locked": {
      "default": false,
      "title": "Locked",
      "type": "boolean"
    },
    "locked_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Locked At"
    },
    "content_sha256": {
      "default": "",
      "title": "Content Sha256",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "id",
    "project_id",
    "character_id",
    "source",
    "speaker_embedding_model",
    "speaker_embedding",
    "prosody",
    "emotion_map",
    "seed",
    "style_lock"
  ],
  "title": "VoiceProfile",
  "type": "object"
}
