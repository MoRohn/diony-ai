{
  "description": "A character's voice card (Blueprint 31 \u00a710). ``gender``, ``age_band``\nand ``timbre`` are the castable read every spoken prompt carries so the\nprovider voices the character as written \u2014 and voices two characters as\ntwo people. ``source`` says who wrote the card: the screenwriter brain,\nthe deterministic derivation from the casting notes, or the user.",
  "properties": {
    "voice_id": {
      "title": "Voice Id",
      "type": "string"
    },
    "engine": {
      "default": "omni_preset",
      "enum": [
        "omni_preset",
        "flow_user_voice",
        "none"
      ],
      "title": "Engine",
      "type": "string"
    },
    "engine_ref": {
      "default": "",
      "title": "Engine Ref",
      "type": "string"
    },
    "sample_asset_id": {
      "default": "",
      "title": "Sample Asset Id",
      "type": "string"
    },
    "accent": {
      "default": "",
      "title": "Accent",
      "type": "string"
    },
    "pace_wpm": {
      "default": 150,
      "exclusiveMinimum": 0,
      "title": "Pace Wpm",
      "type": "integer"
    },
    "pitch_band": {
      "default": "",
      "title": "Pitch Band",
      "type": "string"
    },
    "mic_distance": {
      "default": "close, dry",
      "title": "Mic Distance",
      "type": "string"
    },
    "approved": {
      "default": false,
      "title": "Approved",
      "type": "boolean"
    },
    "gender": {
      "default": "",
      "enum": [
        "",
        "female",
        "male"
      ],
      "title": "Gender",
      "type": "string"
    },
    "age_band": {
      "default": "",
      "title": "Age Band",
      "type": "string"
    },
    "timbre": {
      "default": "",
      "title": "Timbre",
      "type": "string"
    },
    "source": {
      "default": "derived",
      "enum": [
        "brain",
        "derived",
        "user"
      ],
      "title": "Source",
      "type": "string"
    }
  },
  "required": [
    "voice_id"
  ],
  "title": "VoiceProfile",
  "type": "object"
}
