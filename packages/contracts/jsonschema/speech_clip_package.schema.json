{
  "$defs": {
    "SpeechQCReceipt": {
      "description": "What the audio Wan2.2 delivered inside the negative measured.",
      "properties": {
        "measurement_version": {
          "title": "Measurement Version",
          "type": "string"
        },
        "audio_present": {
          "default": false,
          "title": "Audio Present",
          "type": "boolean"
        },
        "duration_ms": {
          "default": 0.0,
          "minimum": 0,
          "title": "Duration Ms",
          "type": "number"
        },
        "window_ms": {
          "default": 0.0,
          "minimum": 0,
          "title": "Window Ms",
          "type": "number"
        },
        "speech_presence_score": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Speech Presence Score"
        },
        "speech_presence_min": {
          "default": 0.2,
          "maximum": 1,
          "minimum": 0,
          "title": "Speech Presence Min",
          "type": "number"
        },
        "line_word_count": {
          "default": 0,
          "minimum": 0,
          "title": "Line Word Count",
          "type": "integer"
        },
        "expected_speech_ms": {
          "default": 0.0,
          "minimum": 0,
          "title": "Expected Speech Ms",
          "type": "number"
        },
        "dialogue_sha256": {
          "default": "",
          "pattern": "^(?:|[0-9a-f]{64})$",
          "title": "Dialogue Sha256",
          "type": "string"
        },
        "request_sha256": {
          "default": "",
          "title": "Request Sha256",
          "type": "string"
        },
        "speech_tail_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Speech Tail Ms"
        },
        "speech_tail_min_ms": {
          "default": 62.5,
          "minimum": 0,
          "title": "Speech Tail Min Ms",
          "type": "number"
        },
        "integrated_lufs": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Integrated Lufs"
        },
        "loudness_target_lufs": {
          "default": -24.0,
          "title": "Loudness Target Lufs",
          "type": "number"
        },
        "loudness_tolerance_lu": {
          "default": 1.0,
          "maximum": 3,
          "minimum": 0,
          "title": "Loudness Tolerance Lu",
          "type": "number"
        },
        "true_peak_dbtp": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "True Peak Dbtp"
        },
        "true_peak_ceiling_dbtp": {
          "default": -1.0,
          "title": "True Peak Ceiling Dbtp",
          "type": "number"
        },
        "transcript": {
          "default": "",
          "title": "Transcript",
          "type": "string"
        },
        "transcript_word_accuracy": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transcript Word Accuracy"
        },
        "transcript_last_word_ok": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transcript Last Word Ok"
        },
        "transcript_min_accuracy": {
          "default": 0.6,
          "maximum": 1,
          "minimum": 0,
          "title": "Transcript Min Accuracy",
          "type": "number"
        },
        "transcript_word_count": {
          "default": 0,
          "minimum": 0,
          "title": "Transcript Word Count",
          "type": "integer"
        },
        "transcript_gate_min_words": {
          "default": 6,
          "minimum": 1,
          "title": "Transcript Gate Min Words",
          "type": "integer"
        },
        "passed": {
          "default": false,
          "title": "Passed",
          "type": "boolean"
        },
        "diagnostics": {
          "items": {
            "type": "string"
          },
          "title": "Diagnostics",
          "type": "array"
        }
      },
      "required": [
        "measurement_version"
      ],
      "title": "SpeechQCReceipt",
      "type": "object"
    },
    "VoiceRenderState": {
      "enum": [
        "planned",
        "audio_locked",
        "verified",
        "failed"
      ],
      "title": "VoiceRenderState",
      "type": "string"
    },
    "WanSpeechRequest": {
      "description": "Exactly what Producer hands Wan2.2 S2V's native TTS lane for one Take.",
      "properties": {
        "version": {
          "default": "wan22-s2v-native-tts-v1",
          "title": "Version",
          "type": "string"
        },
        "character_id": {
          "title": "Character Id",
          "type": "string"
        },
        "casting_id": {
          "title": "Casting Id",
          "type": "string"
        },
        "tts_text": {
          "title": "Tts Text",
          "type": "string"
        },
        "tts_prompt_audio_sha256": {
          "default": "",
          "pattern": "^(?:|[0-9a-f]{64})$",
          "title": "Tts Prompt Audio Sha256",
          "type": "string"
        },
        "tts_prompt_text": {
          "default": "",
          "title": "Tts Prompt Text",
          "type": "string"
        },
        "prompt_source": {
          "default": "",
          "title": "Prompt Source",
          "type": "string"
        },
        "word_count": {
          "default": 0,
          "minimum": 0,
          "title": "Word Count",
          "type": "integer"
        },
        "window_ms": {
          "exclusiveMinimum": 0,
          "title": "Window Ms",
          "type": "integer"
        },
        "performance_direction": {
          "default": "",
          "title": "Performance Direction",
          "type": "string"
        },
        "content_sha256": {
          "default": "",
          "title": "Content Sha256",
          "type": "string"
        }
      },
      "required": [
        "character_id",
        "casting_id",
        "tts_text",
        "window_ms"
      ],
      "title": "WanSpeechRequest",
      "type": "object"
    }
  },
  "description": "One spoken Take's Wan2.2-native speech evidence, bound to the rendered negative.",
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "shot_id": {
      "title": "Shot Id",
      "type": "string"
    },
    "take_id": {
      "title": "Take Id",
      "type": "string"
    },
    "character_id": {
      "title": "Character Id",
      "type": "string"
    },
    "casting_id": {
      "title": "Casting Id",
      "type": "string"
    },
    "request": {
      "$ref": "#/$defs/WanSpeechRequest"
    },
    "backend": {
      "default": "wan2.2-s2v-native-tts",
      "title": "Backend",
      "type": "string"
    },
    "dialogue_asset_id": {
      "default": "",
      "title": "Dialogue Asset Id",
      "type": "string"
    },
    "mix_stem_asset_id": {
      "default": "",
      "title": "Mix Stem Asset Id",
      "type": "string"
    },
    "video_sha256": {
      "default": "",
      "pattern": "^(?:|[0-9a-f]{64})$",
      "title": "Video Sha256",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/VoiceRenderState",
      "default": "planned"
    },
    "qc": {
      "anyOf": [
        {
          "$ref": "#/$defs/SpeechQCReceipt"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "id",
    "project_id",
    "shot_id",
    "take_id",
    "character_id",
    "casting_id",
    "request"
  ],
  "title": "SpeechClipPackage",
  "type": "object"
}
