{
  "$defs": {
    "CloudGenerationMode": {
      "enum": [
        "t2v",
        "i2v",
        "r2v",
        "first_last",
        "v2v_edit",
        "extension",
        "upscale",
        "image"
      ],
      "title": "CloudGenerationMode",
      "type": "string"
    },
    "CloudProvider": {
      "enum": [
        "grok",
        "google-flow"
      ],
      "title": "CloudProvider",
      "type": "string"
    },
    "CostEstimate": {
      "properties": {
        "schema_version": {
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "workspace_id": {
          "title": "Workspace Id",
          "type": "string"
        },
        "project_id": {
          "default": "",
          "title": "Project Id",
          "type": "string"
        },
        "op_id": {
          "default": "",
          "title": "Op Id",
          "type": "string"
        },
        "currency": {
          "const": "USD",
          "default": "USD",
          "title": "Currency",
          "type": "string"
        },
        "lines": {
          "items": {
            "$ref": "#/$defs/CostEstimateLine"
          },
          "title": "Lines",
          "type": "array"
        },
        "revision_allowance_usd_micros": {
          "default": 0,
          "minimum": 0,
          "title": "Revision Allowance Usd Micros",
          "type": "integer"
        },
        "total_usd_micros": {
          "default": 0,
          "minimum": 0,
          "title": "Total Usd Micros",
          "type": "integer"
        },
        "rate_cards_stale": {
          "default": false,
          "title": "Rate Cards Stale",
          "type": "boolean"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "workspace_id"
      ],
      "title": "CostEstimate",
      "type": "object"
    },
    "CostEstimateLine": {
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "provider_id": {
          "title": "Provider Id",
          "type": "string"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "unit_rate_usd_micros": {
          "default": 0,
          "minimum": 0,
          "title": "Unit Rate Usd Micros",
          "type": "integer"
        },
        "quantity_microunits": {
          "default": 0,
          "minimum": 0,
          "title": "Quantity Microunits",
          "type": "integer"
        },
        "internal_credits": {
          "default": 0,
          "minimum": 0,
          "title": "Internal Credits",
          "type": "integer"
        },
        "usd_micros": {
          "minimum": 0,
          "title": "Usd Micros",
          "type": "integer"
        },
        "rate_card_id": {
          "default": "",
          "title": "Rate Card Id",
          "type": "string"
        }
      },
      "required": [
        "label",
        "provider_id",
        "model",
        "unit",
        "usd_micros"
      ],
      "title": "CostEstimateLine",
      "type": "object"
    },
    "DirectorOpType": {
      "enum": [
        "generate",
        "edit",
        "extend",
        "reimage",
        "recast",
        "swap_provider",
        "upscale",
        "assemble",
        "accept",
        "hold"
      ],
      "title": "DirectorOpType",
      "type": "string"
    }
  },
  "properties": {
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "session_id": {
      "title": "Session Id",
      "type": "string"
    },
    "op": {
      "$ref": "#/$defs/DirectorOpType"
    },
    "project_id": {
      "default": "",
      "title": "Project Id",
      "type": "string"
    },
    "shot_id": {
      "default": "",
      "title": "Shot Id",
      "type": "string"
    },
    "clip_id": {
      "default": "",
      "title": "Clip Id",
      "type": "string"
    },
    "provider": {
      "anyOf": [
        {
          "$ref": "#/$defs/CloudProvider"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "model": {
      "default": "",
      "title": "Model",
      "type": "string"
    },
    "mode": {
      "anyOf": [
        {
          "$ref": "#/$defs/CloudGenerationMode"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "prompt": {
      "default": "",
      "title": "Prompt",
      "type": "string"
    },
    "prompt_version": {
      "default": "",
      "title": "Prompt Version",
      "type": "string"
    },
    "duration_s": {
      "default": 0,
      "minimum": 0,
      "title": "Duration S",
      "type": "number"
    },
    "resolution": {
      "default": "720p",
      "title": "Resolution",
      "type": "string"
    },
    "artifact_refs": {
      "additionalProperties": true,
      "title": "Artifact Refs",
      "type": "object"
    },
    "narration": {
      "default": "",
      "title": "Narration",
      "type": "string"
    },
    "estimate": {
      "anyOf": [
        {
          "$ref": "#/$defs/CostEstimate"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "rationale": {
      "default": "",
      "title": "Rationale",
      "type": "string"
    },
    "requires_confirmation": {
      "default": true,
      "title": "Requires Confirmation",
      "type": "boolean"
    },
    "status": {
      "default": "proposed",
      "enum": [
        "proposed",
        "deriving",
        "approved",
        "submitting",
        "submitted",
        "completed",
        "failed",
        "discarded"
      ],
      "title": "Status",
      "type": "string"
    },
    "job_id": {
      "default": "",
      "title": "Job Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "id",
    "session_id",
    "op"
  ],
  "title": "DirectorOp",
  "type": "object"
}
