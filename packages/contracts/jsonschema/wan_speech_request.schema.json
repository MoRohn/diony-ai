{
  "description": "Exactly what Producer hands Wan2.2 S2V's native TTS lane for one Take.",
  "properties": {
    "version": {
      "default": "wan22-s2v-native-tts-v1",
      "title": "Version",
      "type": "string"
    },
    "character_id": {
      "title": "Character Id",
      "type": "string"
    },
    "casting_id": {
      "title": "Casting Id",
      "type": "string"
    },
    "tts_text": {
      "title": "Tts Text",
      "type": "string"
    },
    "tts_prompt_audio_sha256": {
      "default": "",
      "pattern": "^(?:|[0-9a-f]{64})$",
      "title": "Tts Prompt Audio Sha256",
      "type": "string"
    },
    "tts_prompt_text": {
      "default": "",
      "title": "Tts Prompt Text",
      "type": "string"
    },
    "prompt_source": {
      "default": "",
      "title": "Prompt Source",
      "type": "string"
    },
    "word_count": {
      "default": 0,
      "minimum": 0,
      "title": "Word Count",
      "type": "integer"
    },
    "window_ms": {
      "exclusiveMinimum": 0,
      "title": "Window Ms",
      "type": "integer"
    },
    "performance_direction": {
      "default": "",
      "title": "Performance Direction",
      "type": "string"
    },
    "content_sha256": {
      "default": "",
      "title": "Content Sha256",
      "type": "string"
    }
  },
  "required": [
    "character_id",
    "casting_id",
    "tts_text",
    "window_ms"
  ],
  "title": "WanSpeechRequest",
  "type": "object"
}
