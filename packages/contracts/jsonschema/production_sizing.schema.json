{
  "description": "Honest wall-clock sizing from measured clip latencies, never a guess.",
  "properties": {
    "basis": {
      "default": "unmeasured",
      "title": "Basis",
      "type": "string"
    },
    "shot_count": {
      "minimum": 0,
      "title": "Shot Count",
      "type": "integer"
    },
    "planned_takes": {
      "minimum": 0,
      "title": "Planned Takes",
      "type": "integer"
    },
    "measured_clips": {
      "default": 0,
      "minimum": 0,
      "title": "Measured Clips",
      "type": "integer"
    },
    "camera_p50_seconds": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Camera P50 Seconds"
    },
    "finish_p50_seconds": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finish P50 Seconds"
    },
    "retake_allowance": {
      "default": 1.3,
      "title": "Retake Allowance",
      "type": "number"
    },
    "estimated_seconds_low": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Estimated Seconds Low"
    },
    "estimated_seconds_high": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Estimated Seconds High"
    }
  },
  "required": [
    "shot_count",
    "planned_takes"
  ],
  "title": "ProductionSizing",
  "type": "object"
}
