      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "take_id": {
          "title": "Take Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "project_id": {
          "default": "",
          "title": "Project Id",
          "type": "string"
        },
        "shot_id": {
          "default": "",
          "title": "Shot Id",
          "type": "string"
        },
        "sha256": {
          "default": "",
          "title": "Sha256",
          "type": "string"
        },
        "source_sha256": {
          "default": "",
          "title": "Source Sha256",
          "type": "string"
        },
        "prompt_sha256": {
          "default": "",
          "title": "Prompt Sha256",
          "type": "string"
        },
        "reference_asset_ids": {
          "items": {
            "type": "string"
