    "SpeechClipPackage": {
      "description": "One spoken Take's Wan2.2-native speech evidence, bound to the rendered negative.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "shot_id": {
          "title": "Shot Id",
          "type": "string"
        },
        "take_id": {
          "title": "Take Id",
          "type": "string"
        },
        "character_id": {
          "title": "Character Id",
          "type": "string"
        },
        "casting_id": {
          "title": "Casting Id",
          "type": "string"
        },
        "request": {
          "$ref": "#/$defs/WanSpeechRequest"
        },
        "backend": {
          "default": "wan2.2-s2v-native-tts",
          "title": "Backend",
          "type": "string"
        },
        "dialogue_asset_id": {
          "default": "",
          "title": "Dialogue Asset Id",
          "type": "string"
        },
        "mix_stem_asset_id": {
          "default": "",
          "title": "Mix Stem Asset Id",
          "type": "string"
        },
        "video_sha256": {
          "default": "",
          "pattern": "^(?:|[0-9a-f]{64})$",
          "title": "Video Sha256",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/VoiceRenderState",
          "default": "planned"
        },
        "qc": {
          "anyOf": [
            {
              "$ref": "#/$defs/SpeechQCReceipt"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "project_id",
        "shot_id",
        "take_id",
        "character_id",
        "casting_id",
        "request"
      ],
      "title": "SpeechClipPackage",
      "type": "object"
    },
