          "title": "Continuity From Take Id"
        },
        "continuity_sha256": {
          "default": "",
          "title": "Continuity Sha256",
          "type": "string"
        },
        "generation_task": {
          "default": "",
          "title": "Generation Task",
          "type": "string"
        },
        "bytes": {
          "default": 0,
          "title": "Bytes",
          "type": "integer"
        },
        "width": {
          "default": 1280,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "default": 720,
          "title": "Height",
          "type": "integer"
        },
        "fps": {
          "default": 23.976,
          "title": "Fps",
          "type": "number"
        },
        "duration_frames": {
          "default": 0,
          "title": "Duration Frames",
          "type": "integer"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "take_id",
        "kind",
        "path"
      ],
      "title": "Artifact",
      "type": "object"
    },
    "ArtifactKind": {
      "enum": [
        "negative_720",
        "finish_1080",
        "proxy"
      ],
      "title": "ArtifactKind",
      "type": "string"
    },
    "Engine": {
      "enum": [
        "t2v-A14B",
        "i2v-A14B",
        "ti2v-5B",
        "s2v-14B",
        "animate-14B",
        "vace-fun-A14B"
      ],
      "title": "Engine",
      "type": "string"
    },
    "GenerationExecutionReceipt": {
      "description": "Immutable evidence for the generation lane that actually produced a Take.",
      "properties": {
        "schema_version": {
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "status": {
          "enum": [
            "succeeded",
