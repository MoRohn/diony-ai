        },
        "backend": {
          "title": "Backend",
          "type": "string"
        },
        "selected_lane": {
          "title": "Selected Lane",
          "type": "string"
        },
        "task": {
          "title": "Task",
          "type": "string"
        },
        "native_width": {
          "exclusiveMinimum": 0,
          "title": "Native Width",
          "type": "integer"
        },
        "native_height": {
          "exclusiveMinimum": 0,
          "title": "Native Height",
          "type": "integer"
        },
        "frame_num": {
          "exclusiveMinimum": 0,
          "title": "Frame Num",
          "type": "integer"
        },
        "sample_steps": {
          "exclusiveMinimum": 0,
          "title": "Sample Steps",
          "type": "integer"
        },
        "inference_frames_per_pass": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
