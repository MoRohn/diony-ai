          ],
          "default": null,
          "title": "Inference Frames Per Pass"
        },
        "denoise_passes": {
          "default": 1,
          "minimum": 1,
          "title": "Denoise Passes",
          "type": "integer"
        },
        "effective_denoise_steps": {
          "default": 0,
          "minimum": 0,
          "title": "Effective Denoise Steps",
          "type": "integer"
        },
        "sample_solver": {
          "title": "Sample Solver",
          "type": "string"
        },
        "precision": {
          "title": "Precision",
          "type": "string"
        },
        "negative_conditioning": {
          "title": "Negative Conditioning",
          "type": "boolean"
        },
        "finish_required": {
          "default": true,
          "title": "Finish Required",
          "type": "boolean"
        },
        "quality_contract_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "title": "Quality Contract Sha256",
          "type": "string"
        },
        "quality_contract_matched": {
          "title": "Quality Contract Matched",
          "type": "boolean"
        },
        "attention_backend": {
          "default": "auto",
          "title": "Attention Backend",
          "type": "string"
        },
        "lead_frames": {
          "default": 0,
          "maximum": 32,
          "minimum": 0,
          "title": "Lead Frames",
          "type": "integer"
        },
        "head_hold_frames": {
          "default": 0,
          "maximum": 32,
          "minimum": 0,
          "title": "Head Hold Frames",
          "type": "integer"
        },
        "sample_guide_scale": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
