        },
        "fallback_reason": {
          "default": "",
          "title": "Fallback Reason",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        },
        "elapsed_seconds": {
          "default": 0,
          "minimum": 0,
          "title": "Elapsed Seconds",
          "type": "number"
        },
        "output_sha256": {
          "default": "",
          "title": "Output Sha256",
          "type": "string"
        },
        "output_bytes": {
          "default": 0,
          "minimum": 0,
          "title": "Output Bytes",
          "type": "integer"
        },
        "error": {
          "default": "",
          "title": "Error",
          "type": "string"
        }
