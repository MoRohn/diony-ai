          "title": "Continuity From Take Id"
        },
        "continuity_sha256": {
          "default": "",
          "title": "Continuity Sha256",
          "type": "string"
        },
        "generation_task": {
          "default": "",
          "title": "Generation Task",
          "type": "string"
        },
        "bytes": {
          "default": 0,
          "title": "Bytes",
          "type": "integer"
        },
        "width": {
          "default": 1280,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "default": 720,
          "title": "Height",
          "type": "integer"
        },
        "fps": {
          "default": 23.976,
          "title": "Fps",
          "type": "number"
        },
        "duration_frames": {
          "default": 0,
          "title": "Duration Frames",
          "type": "integer"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "take_id",
        "kind",
        "path"
      ],
      "title": "Artifact",
      "type": "object"
    },
    "ArtifactKind": {
      "enum": [
        "negative_720",
        "finish_1080",
        "proxy"
      ],
      "title": "ArtifactKind",
      "type": "string"
    },
    "Engine": {
      "enum": [
        "t2v-A14B",
        "i2v-A14B",
        "ti2v-5B",
        "s2v-14B",
        "animate-14B",
        "vace-fun-A14B"
      ],
      "title": "Engine",
      "type": "string"
    },
    "GenerationExecutionReceipt": {
      "description": "Immutable evidence for the generation lane that actually produced a Take.",
      "properties": {
        "schema_version": {
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "status": {
          "enum": [
            "succeeded",
            "failed",
            "cancelled"
          ],
          "title": "Status",
          "type": "string"
        },
        "backend": {
          "title": "Backend",
          "type": "string"
        },
        "selected_lane": {
          "title": "Selected Lane",
          "type": "string"
        },
        "task": {
          "title": "Task",
          "type": "string"
        },
        "native_width": {
          "exclusiveMinimum": 0,
          "title": "Native Width",
          "type": "integer"
        },
        "native_height": {
          "exclusiveMinimum": 0,
          "title": "Native Height",
          "type": "integer"
        },
        "frame_num": {
          "exclusiveMinimum": 0,
          "title": "Frame Num",
          "type": "integer"
        },
        "sample_steps": {
          "exclusiveMinimum": 0,
          "title": "Sample Steps",
          "type": "integer"
        },
        "inference_frames_per_pass": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inference Frames Per Pass"
        },
        "denoise_passes": {
          "default": 1,
          "minimum": 1,
          "title": "Denoise Passes",
          "type": "integer"
        },
        "effective_denoise_steps": {
          "default": 0,
          "minimum": 0,
          "title": "Effective Denoise Steps",
          "type": "integer"
        },
        "sample_solver": {
          "title": "Sample Solver",
          "type": "string"
        },
        "precision": {
          "title": "Precision",
          "type": "string"
        },
        "negative_conditioning": {
          "title": "Negative Conditioning",
          "type": "boolean"
        },
        "finish_required": {
          "default": true,
          "title": "Finish Required",
          "type": "boolean"
        },
        "quality_contract_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "title": "Quality Contract Sha256",
          "type": "string"
        },
        "quality_contract_matched": {
          "title": "Quality Contract Matched",
          "type": "boolean"
        },
        "attention_backend": {
          "default": "auto",
          "title": "Attention Backend",
          "type": "string"
        },
        "resident_reason": {
          "default": "",
          "title": "Resident Reason",
          "type": "string"
        },
        "resident_receipt_sha256": {
          "default": "",
          "title": "Resident Receipt Sha256",
          "type": "string"
        },
        "resident_kernel_mode": {
          "default": "",
          "title": "Resident Kernel Mode",
          "type": "string"
        },
        "fallback_reason": {
          "default": "",
          "title": "Fallback Reason",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        },
        "elapsed_seconds": {
          "default": 0,
          "minimum": 0,
          "title": "Elapsed Seconds",
          "type": "number"
        },
        "output_sha256": {
          "default": "",
          "title": "Output Sha256",
          "type": "string"
        },
        "output_bytes": {
          "default": 0,
          "minimum": 0,
          "title": "Output Bytes",
          "type": "integer"
        },
        "error": {
          "default": "",
          "title": "Error",
          "type": "string"
        }
