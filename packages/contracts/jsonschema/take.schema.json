        "status",
        "backend",
        "selected_lane",
        "task",
        "native_width",
        "native_height",
        "frame_num",
        "sample_steps",
        "sample_solver",
        "precision",
        "negative_conditioning",
        "quality_contract_sha256",
        "quality_contract_matched"
      ],
      "title": "GenerationExecutionReceipt",
      "type": "object"
