{
  "$defs": {
    "ClipJoinPoint": {
      "properties": {
        "left_clip_id": {
          "title": "Left Clip Id",
          "type": "string"
        },
        "right_clip_id": {
          "title": "Right Clip Id",
          "type": "string"
        },
        "transition": {
          "$ref": "#/$defs/GalleryTransition",
          "default": "cut"
        },
        "duration_frames": {
          "default": 0,
          "maximum": 120,
          "minimum": 0,
          "title": "Duration Frames",
          "type": "integer"
        }
      },
      "required": [
        "left_clip_id",
        "right_clip_id"
      ],
      "title": "ClipJoinPoint",
      "type": "object"
    },
    "ClipJoinSource": {
      "description": "One immutable Gallery clip reference with frame-authoritative trims.",
      "properties": {
        "clip_id": {
          "title": "Clip Id",
          "type": "string"
        },
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "duration_frames": {
          "minimum": 2,
          "title": "Duration Frames",
          "type": "integer"
        },
        "trim_in_frame": {
          "default": 0,
          "minimum": 0,
          "title": "Trim In Frame",
          "type": "integer"
        },
        "trim_out_frame": {
          "minimum": 1,
          "title": "Trim Out Frame",
          "type": "integer"
        },
        "fps": {
          "exclusiveMinimum": 0,
          "title": "Fps",
          "type": "number"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "integer"
        },
        "codec": {
          "default": "unknown",
          "title": "Codec",
          "type": "string"
        },
        "normalized": {
          "default": false,
          "title": "Normalized",
          "type": "boolean"
        },
        "normalization_note": {
          "default": "",
          "title": "Normalization Note",
          "type": "string"
        }
      },
      "required": [
        "clip_id",
        "project_id",
        "title",
        "path",
        "duration_frames",
        "trim_out_frame",
        "fps",
        "width",
        "height"
      ],
      "title": "ClipJoinSource",
      "type": "object"
    },
    "GalleryCompositionStatus": {
      "enum": [
        "draft",
        "queued",
        "processing",
        "complete",
        "failed",
        "cancelled",
        "superseded"
      ],
      "title": "GalleryCompositionStatus",
      "type": "string"
    },
    "GalleryTransition": {
      "enum": [
        "cut",
        "cross_dissolve",
        "film_dissolve",
        "fade_through_black",
        "dip_to_white",
        "wipe_left",
        "wipe_right"
      ],
      "title": "GalleryTransition",
      "type": "string"
    }
  },
  "description": "Non-destructive Gallery composition and exportable source lineage.",
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "version": {
      "default": 1,
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    },
    "parent_composition_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Composition Id"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/ClipJoinSource"
      },
      "maxItems": 32,
      "minItems": 2,
      "title": "Sources",
      "type": "array"
    },
    "junctions": {
      "items": {
        "$ref": "#/$defs/ClipJoinPoint"
      },
      "maxItems": 31,
      "minItems": 1,
      "title": "Junctions",
      "type": "array"
    },
    "source_asset_ids": {
      "items": {
        "type": "string"
      },
      "title": "Source Asset Ids",
      "type": "array"
    },
    "asset_id": {
      "default": "",
      "title": "Asset Id",
      "type": "string"
    },
    "width": {
      "default": 1920,
      "title": "Width",
      "type": "integer"
    },
    "height": {
      "default": 1080,
      "title": "Height",
      "type": "integer"
    },
    "fps": {
      "default": 23.976,
      "title": "Fps",
      "type": "number"
    },
    "color_space": {
      "default": "rec709",
      "title": "Color Space",
      "type": "string"
    },
    "total_frames": {
      "default": 0,
      "title": "Total Frames",
      "type": "integer"
    },
    "profile_name": {
      "default": "",
      "title": "Profile Name",
      "type": "string"
    },
    "cost_center_ids": {
      "items": {
        "type": "string"
      },
      "title": "Cost Center Ids",
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/GalleryCompositionStatus",
      "default": "draft"
    },
    "output_path": {
      "default": "",
      "title": "Output Path",
      "type": "string"
    },
    "proxy_path": {
      "default": "",
      "title": "Proxy Path",
      "type": "string"
    },
    "preview_path": {
      "default": "",
      "title": "Preview Path",
      "type": "string"
    },
    "manifest_path": {
      "default": "",
      "title": "Manifest Path",
      "type": "string"
    },
    "error": {
      "default": "",
      "title": "Error",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "id",
    "project_id",
    "sources",
    "junctions"
  ],
  "title": "ClipComposition",
  "type": "object"
}
