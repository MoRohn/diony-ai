{
  "$defs": {
    "CutTransition": {
      "properties": {
        "kind": {
          "default": "cut",
          "title": "Kind",
          "type": "string"
        },
        "frames": {
          "default": 0,
          "minimum": 0,
          "title": "Frames",
          "type": "integer"
        }
      },
      "title": "CutTransition",
      "type": "object"
    },
    "EditDecision": {
      "properties": {
        "index": {
          "minimum": 1,
          "title": "Index",
          "type": "integer"
        },
        "shot_id": {
          "title": "Shot Id",
          "type": "string"
        },
        "take_id": {
          "default": "",
          "title": "Take Id",
          "type": "string"
        },
        "reel": {
          "default": "",
          "title": "Reel",
          "type": "string"
        },
        "source_in": {
          "minimum": 0,
          "title": "Source In",
          "type": "integer"
        },
        "source_out": {
          "exclusiveMinimum": 0,
          "title": "Source Out",
          "type": "integer"
        },
        "record_in": {
          "minimum": 0,
          "title": "Record In",
          "type": "integer"
        },
        "record_out": {
          "exclusiveMinimum": 0,
          "title": "Record Out",
          "type": "integer"
        },
        "transition_in": {
          "$ref": "#/$defs/CutTransition"
        },
        "role": {
          "default": "",
          "title": "Role",
          "type": "string"
        },
        "reason": {
          "default": "",
          "title": "Reason",
          "type": "string"
        },
        "speaker": {
          "default": "",
          "title": "Speaker",
          "type": "string"
        },
        "hero": {
          "default": false,
          "title": "Hero",
          "type": "boolean"
        },
        "engine": {
          "default": "",
          "title": "Engine",
          "type": "string"
        },
        "continuity": {
          "default": "",
          "title": "Continuity",
          "type": "string"
        },
        "slug": {
          "default": "",
          "title": "Slug",
          "type": "string"
        }
      },
      "required": [
        "index",
        "shot_id",
        "source_in",
        "source_out",
        "record_in",
        "record_out"
      ],
      "title": "EditDecision",
      "type": "object"
    }
  },
  "properties": {
    "version": {
      "default": "diony-edl-v1",
      "title": "Version",
      "type": "string"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "timeline_id": {
      "title": "Timeline Id",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "fps": {
      "title": "Fps",
      "type": "number"
    },
    "total_frames": {
      "minimum": 0,
      "title": "Total Frames",
      "type": "integer"
    },
    "decisions": {
      "items": {
        "$ref": "#/$defs/EditDecision"
      },
      "title": "Decisions",
      "type": "array"
    },
    "transition_families": {
      "items": {
        "type": "string"
      },
      "title": "Transition Families",
      "type": "array"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "timeline_id",
    "title",
    "fps",
    "total_frames"
  ],
  "title": "EditDecisionList",
  "type": "object"
}
