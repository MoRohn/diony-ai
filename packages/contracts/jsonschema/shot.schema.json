{
  "$defs": {
    "CameraMove": {
      "enum": [
        "static",
        "pan",
        "tilt",
        "dolly_in",
        "dolly_out",
        "track",
        "crane",
        "handheld",
        "steadicam",
        "zoom"
      ],
      "title": "CameraMove",
      "type": "string"
    },
    "ContinuityMode": {
      "enum": [
        "independent",
        "reference",
        "previous_frame"
      ],
      "title": "ContinuityMode",
      "type": "string"
    },
    "Engine": {
      "enum": [
        "t2v-A14B",
        "i2v-A14B",
        "ti2v-5B",
        "s2v-14B",
        "animate-14B",
        "vace-fun-A14B"
      ],
      "title": "Engine",
      "type": "string"
    },
    "FinishIntent": {
      "enum": [
        "previz",
        "proxy",
        "deliverable"
      ],
      "title": "FinishIntent",
      "type": "string"
    },
    "ReferenceLock": {
      "enum": [
        "none",
        "character",
        "character_and_background"
      ],
      "title": "ReferenceLock",
      "type": "string"
    },
    "WanPromptPlan": {
      "description": "Typed, inspectable Wan2.2 prompt layers compiled from the Idea.",
      "properties": {
        "strategy_version": {
          "default": "wan22-five-layer-v3",
          "title": "Strategy Version",
          "type": "string"
        },
        "source_idea_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "title": "Source Idea Sha256",
          "type": "string"
        },
        "subject": {
          "title": "Subject",
          "type": "string"
        },
        "identity_anchors": {
          "items": {
            "type": "string"
          },
          "title": "Identity Anchors",
          "type": "array"
        },
        "motion": {
          "title": "Motion",
          "type": "string"
        },
        "camera": {
          "title": "Camera",
          "type": "string"
        },
        "scene": {
          "title": "Scene",
          "type": "string"
        },
        "environment_dynamics": {
          "default": "",
          "title": "Environment Dynamics",
          "type": "string"
        },
        "high_noise_plan": {
          "default": "",
          "title": "High Noise Plan",
          "type": "string"
        },
        "low_noise_plan": {
          "default": "",
          "title": "Low Noise Plan",
          "type": "string"
        },
        "generation_method": {
          "default": "",
          "title": "Generation Method",
          "type": "string"
        },
        "audio_strategy": {
          "default": "silent_plate",
          "title": "Audio Strategy",
          "type": "string"
        },
        "quality_lora_ids": {
          "items": {
            "type": "string"
          },
          "title": "Quality Lora Ids",
          "type": "array"
        },
        "continuity_risks": {
          "items": {
            "type": "string"
          },
          "title": "Continuity Risks",
          "type": "array"
        },
        "negative_terms": {
          "items": {
            "type": "string"
          },
          "title": "Negative Terms",
          "type": "array"
        },
        "word_count": {
          "default": 0,
          "minimum": 0,
          "title": "Word Count",
          "type": "integer"
        },
        "diagnostics": {
          "items": {
            "type": "string"
          },
          "title": "Diagnostics",
          "type": "array"
        }
      },
      "required": [
        "source_idea_sha256",
        "subject",
        "motion",
        "camera",
        "scene"
      ],
      "title": "WanPromptPlan",
      "type": "object"
    }
  },
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "scene": {
      "title": "Scene",
      "type": "string"
    },
    "slug": {
      "title": "Slug",
      "type": "string"
    },
    "duration_frames": {
      "title": "Duration Frames",
      "type": "integer"
    },
    "fps": {
      "title": "Fps",
      "type": "number"
    },
    "size_native": {
      "default": "1280x720",
      "title": "Size Native",
      "type": "string"
    },
    "focal_mm": {
      "title": "Focal Mm",
      "type": "number"
    },
    "t_stop": {
      "title": "T Stop",
      "type": "number"
    },
    "lighting_ratio": {
      "title": "Lighting Ratio",
      "type": "string"
    },
    "camera_move": {
      "$ref": "#/$defs/CameraMove"
    },
    "prompt": {
      "title": "Prompt",
      "type": "string"
    },
    "negative_prompt": {
      "default": "",
      "title": "Negative Prompt",
      "type": "string"
    },
    "prompt_plan": {
      "anyOf": [
        {
          "$ref": "#/$defs/WanPromptPlan"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "seed": {
      "title": "Seed",
      "type": "integer"
    },
    "character_ref_ids": {
      "items": {
        "type": "string"
      },
      "title": "Character Ref Ids",
      "type": "array"
    },
    "keyframe_asset_ids": {
      "items": {
        "type": "string"
      },
      "title": "Keyframe Asset Ids",
      "type": "array"
    },
    "audio_asset_ids": {
      "items": {
        "type": "string"
      },
      "title": "Audio Asset Ids",
      "type": "array"
    },
    "motion_reference_asset_ids": {
      "items": {
        "type": "string"
      },
      "title": "Motion Reference Asset Ids",
      "type": "array"
    },
    "reference_lock": {
      "$ref": "#/$defs/ReferenceLock",
      "default": "none"
    },
    "continuity_mode": {
      "$ref": "#/$defs/ContinuityMode",
      "default": "independent"
    },
    "engine": {
      "$ref": "#/$defs/Engine"
    },
    "finish": {
      "$ref": "#/$defs/FinishIntent"
    },
    "audio_line": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Audio Line"
    },
    "overlap_frames": {
      "default": 8,
      "title": "Overlap Frames",
      "type": "integer"
    },
    "max_takes": {
      "default": 4,
      "title": "Max Takes",
      "type": "integer"
    },
    "selected_take_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Selected Take Id"
    }
  },
  "required": [
    "id",
    "scene",
    "slug",
    "duration_frames",
    "fps",
    "focal_mm",
    "t_stop",
    "lighting_ratio",
    "camera_move",
    "prompt",
    "seed",
    "engine",
    "finish"
  ],
  "title": "Shot",
  "type": "object"
}
