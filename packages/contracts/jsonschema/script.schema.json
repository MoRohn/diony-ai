{
  "$defs": {
    "Scene": {
      "properties": {
        "scene_id": {
          "title": "Scene Id",
          "type": "string"
        },
        "heading": {
          "title": "Heading",
          "type": "string"
        },
        "setting_ref": {
          "title": "Setting Ref",
          "type": "string"
        },
        "cast": {
          "items": {
            "type": "string"
          },
          "title": "Cast",
          "type": "array"
        },
        "story_time": {
          "default": "",
          "title": "Story Time",
          "type": "string"
        },
        "line_ids": {
          "items": {
            "type": "string"
          },
          "title": "Line Ids",
          "type": "array"
        },
        "emotional_job": {
          "default": "",
          "title": "Emotional Job",
          "type": "string"
        }
      },
      "required": [
        "scene_id",
        "heading",
        "setting_ref"
      ],
      "title": "Scene",
      "type": "object"
    },
    "ScriptLine": {
      "properties": {
        "line_id": {
          "title": "Line Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "heading",
            "action",
            "cue",
            "dialogue",
            "parenthetical",
            "vo",
            "sound"
          ],
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "speaker": {
          "default": "",
          "title": "Speaker",
          "type": "string"
        },
        "scene_id": {
          "default": "",
          "title": "Scene Id",
          "type": "string"
        },
        "shot": {
          "default": "",
          "title": "Shot",
          "type": "string"
        }
      },
      "required": [
        "line_id",
        "kind",
        "text"
      ],
      "title": "ScriptLine",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "project_id": {
      "default": "",
      "title": "Project Id",
      "type": "string"
    },
    "version": {
      "default": 1,
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    },
    "logline": {
      "default": "",
      "title": "Logline",
      "type": "string"
    },
    "runtime_target_s": {
      "default": 60,
      "exclusiveMinimum": 0,
      "title": "Runtime Target S",
      "type": "integer"
    },
    "beats": {
      "items": {
        "additionalProperties": {
          "type": "string"
        },
        "type": "object"
      },
      "title": "Beats",
      "type": "array"
    },
    "scenes": {
      "items": {
        "$ref": "#/$defs/Scene"
      },
      "title": "Scenes",
      "type": "array"
    },
    "lines": {
      "items": {
        "$ref": "#/$defs/ScriptLine"
      },
      "title": "Lines",
      "type": "array"
    },
    "locked": {
      "default": false,
      "title": "Locked",
      "type": "boolean"
    },
    "locked_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Locked At"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "id"
  ],
  "title": "Script",
  "type": "object"
}
