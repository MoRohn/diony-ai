{
  "$defs": {
    "VoiceProfile": {
      "properties": {
        "voice_id": {
          "title": "Voice Id",
          "type": "string"
        },
        "engine": {
          "default": "omni_preset",
          "enum": [
            "omni_preset",
            "flow_user_voice",
            "none"
          ],
          "title": "Engine",
          "type": "string"
        },
        "engine_ref": {
          "default": "",
          "title": "Engine Ref",
          "type": "string"
        },
        "sample_asset_id": {
          "default": "",
          "title": "Sample Asset Id",
          "type": "string"
        },
        "accent": {
          "default": "",
          "title": "Accent",
          "type": "string"
        },
        "pace_wpm": {
          "default": 150,
          "exclusiveMinimum": 0,
          "title": "Pace Wpm",
          "type": "integer"
        },
        "pitch_band": {
          "default": "",
          "title": "Pitch Band",
          "type": "string"
        },
        "mic_distance": {
          "default": "close, dry",
          "title": "Mic Distance",
          "type": "string"
        },
        "approved": {
          "default": false,
          "title": "Approved",
          "type": "boolean"
        }
      },
      "required": [
        "voice_id"
      ],
      "title": "VoiceProfile",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "char_id": {
      "title": "Char Id",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "role": {
      "default": "",
      "title": "Role",
      "type": "string"
    },
    "sheet_version": {
      "default": 1,
      "minimum": 1,
      "title": "Sheet Version",
      "type": "integer"
    },
    "hero_stills": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Hero Stills",
      "type": "object"
    },
    "wardrobe": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Wardrobe",
      "type": "object"
    },
    "age_body_notes": {
      "default": "",
      "title": "Age Body Notes",
      "type": "string"
    },
    "forbidden_drift": {
      "items": {
        "type": "string"
      },
      "title": "Forbidden Drift",
      "type": "array"
    },
    "grok_ref_pack": {
      "items": {
        "type": "string"
      },
      "title": "Grok Ref Pack",
      "type": "array"
    },
    "flow_media_ids": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Flow Media Ids",
      "type": "object"
    },
    "flow_character_ref": {
      "default": "",
      "title": "Flow Character Ref",
      "type": "string"
    },
    "voice": {
      "anyOf": [
        {
          "$ref": "#/$defs/VoiceProfile"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "casting_card": {
      "default": "",
      "title": "Casting Card",
      "type": "string"
    },
    "face_approved": {
      "default": false,
      "title": "Face Approved",
      "type": "boolean"
    }
  },
  "required": [
    "char_id",
    "name"
  ],
  "title": "CharacterProfile",
  "type": "object"
}
