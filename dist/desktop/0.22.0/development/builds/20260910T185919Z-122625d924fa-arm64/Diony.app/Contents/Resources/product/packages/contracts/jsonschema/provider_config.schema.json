{
  "$defs": {
    "ProviderCapability": {
      "enum": [
        "llm",
        "image",
        "video",
        "tts",
        "audio",
        "assembly",
        "finish",
        "safety",
        "package"
      ],
      "title": "ProviderCapability",
      "type": "string"
    }
  },
  "properties": {
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "workspace_id": {
      "title": "Workspace Id",
      "type": "string"
    },
    "provider_id": {
      "title": "Provider Id",
      "type": "string"
    },
    "label": {
      "title": "Label",
      "type": "string"
    },
    "capabilities": {
      "items": {
        "$ref": "#/$defs/ProviderCapability"
      },
      "title": "Capabilities",
      "type": "array"
    },
    "preferred_models": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Preferred Models",
      "type": "object"
    },
    "enabled": {
      "default": true,
      "title": "Enabled",
      "type": "boolean"
    },
    "byok": {
      "default": false,
      "title": "Byok",
      "type": "boolean"
    },
    "secret_names": {
      "items": {
        "type": "string"
      },
      "title": "Secret Names",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "deleted_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Deleted At"
    }
  },
  "required": [
    "id",
    "workspace_id",
    "provider_id",
    "label"
  ],
  "title": "ProviderConfig",
  "type": "object"
}
