{
  "$defs": {
    "WorkflowStage": {
      "enum": [
        "intake",
        "script",
        "breakdown",
        "consistency",
        "safety_input",
        "image",
        "video",
        "voice",
        "sound",
        "assembly",
        "finish",
        "safety_output",
        "package"
      ],
      "title": "WorkflowStage",
      "type": "string"
    }
  },
  "properties": {
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "seq": {
      "default": 0,
      "title": "Seq",
      "type": "integer"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "workspace_id": {
      "title": "Workspace Id",
      "type": "string"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "stage": {
      "anyOf": [
        {
          "$ref": "#/$defs/WorkflowStage"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "job_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Job Id"
    },
    "kind": {
      "default": "progress",
      "title": "Kind",
      "type": "string"
    },
    "percent": {
      "default": 0,
      "title": "Percent",
      "type": "number"
    },
    "message": {
      "title": "Message",
      "type": "string"
    },
    "level": {
      "default": "info",
      "enum": [
        "info",
        "live",
        "success",
        "warning",
        "error"
      ],
      "title": "Level",
      "type": "string"
    },
    "preview_asset_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Preview Asset Id"
    },
    "estimated_seconds_remaining": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Estimated Seconds Remaining"
    },
    "actions": {
      "items": {
        "type": "string"
      },
      "title": "Actions",
      "type": "array"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "id",
    "run_id",
    "workspace_id",
    "project_id",
    "message"
  ],
  "title": "ProgressEvent",
  "type": "object"
}
