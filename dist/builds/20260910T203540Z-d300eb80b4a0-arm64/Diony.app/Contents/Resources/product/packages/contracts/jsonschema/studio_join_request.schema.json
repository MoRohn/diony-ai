{
  "$defs": {
    "JoinRequestStatus": {
      "enum": [
        "pending",
        "approved",
        "denied",
        "withdrawn"
      ],
      "title": "JoinRequestStatus",
      "type": "string"
    },
    "MembershipRole": {
      "enum": [
        "viewer",
        "creator",
        "producer",
        "admin",
        "owner"
      ],
      "title": "MembershipRole",
      "type": "string"
    }
  },
  "properties": {
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "workspace_id": {
      "title": "Workspace Id",
      "type": "string"
    },
    "invitation_id": {
      "title": "Invitation Id",
      "type": "string"
    },
    "user_id": {
      "title": "User Id",
      "type": "string"
    },
    "email_key": {
      "title": "Email Key",
      "type": "string"
    },
    "requested_profile_name": {
      "title": "Requested Profile Name",
      "type": "string"
    },
    "requested_profile_name_key": {
      "title": "Requested Profile Name Key",
      "type": "string"
    },
    "requested_role": {
      "$ref": "#/$defs/MembershipRole",
      "default": "creator"
    },
    "status": {
      "$ref": "#/$defs/JoinRequestStatus",
      "default": "pending"
    },
    "maker_note": {
      "default": "",
      "title": "Maker Note",
      "type": "string"
    },
    "admin_note": {
      "default": "",
      "title": "Admin Note",
      "type": "string"
    },
    "decided_by": {
      "default": "",
      "title": "Decided By",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "decided_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Decided At"
    }
  },
  "required": [
    "id",
    "workspace_id",
    "invitation_id",
    "user_id",
    "email_key",
    "requested_profile_name",
    "requested_profile_name_key"
  ],
  "title": "StudioJoinRequest",
  "type": "object"
}
