{
  "$defs": {
    "ProviderCapability": {
      "enum": [
        "llm",
        "image",
        "video",
        "tts",
        "audio",
        "assembly",
        "finish",
        "safety",
        "package"
      ],
      "title": "ProviderCapability",
      "type": "string"
    }
  },
  "properties": {
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "workspace_id": {
      "title": "Workspace Id",
      "type": "string"
    },
    "capability": {
      "$ref": "#/$defs/ProviderCapability"
    },
    "provider_id": {
      "title": "Provider Id",
      "type": "string"
    },
    "model": {
      "title": "Model",
      "type": "string"
    },
    "unit": {
      "title": "Unit",
      "type": "string"
    },
    "internal_credits_per_unit": {
      "minimum": 0,
      "title": "Internal Credits Per Unit",
      "type": "integer"
    },
    "cost_usd_micros_per_unit": {
      "minimum": 0,
      "title": "Cost Usd Micros Per Unit",
      "type": "integer"
    },
    "source": {
      "title": "Source",
      "type": "string"
    },
    "effective_from": {
      "format": "date-time",
      "title": "Effective From",
      "type": "string"
    },
    "effective_to": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Effective To"
    },
    "active": {
      "default": true,
      "title": "Active",
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "workspace_id",
    "capability",
    "provider_id",
    "model",
    "unit",
    "internal_credits_per_unit",
    "cost_usd_micros_per_unit",
    "source"
  ],
  "title": "CostRateCard",
  "type": "object"
}
