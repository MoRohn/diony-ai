{
  "$defs": {
    "JobStatus": {
      "enum": [
        "queued",
        "running",
        "waiting_provider",
        "retry_wait",
        "paused",
        "succeeded",
        "failed",
        "canceled",
        "skipped"
      ],
      "title": "JobStatus",
      "type": "string"
    },
    "WorkflowStage": {
      "enum": [
        "intake",
        "script",
        "breakdown",
        "consistency",
        "safety_input",
        "image",
        "video",
        "voice",
        "sound",
        "assembly",
        "finish",
        "safety_output",
        "package"
      ],
      "title": "WorkflowStage",
      "type": "string"
    },
    "WorkflowStageState": {
      "properties": {
        "stage": {
          "$ref": "#/$defs/WorkflowStage"
        },
        "status": {
          "$ref": "#/$defs/JobStatus",
          "default": "queued"
        },
        "progress_percent": {
          "default": 0,
          "title": "Progress Percent",
          "type": "number"
        },
        "job_ids": {
          "items": {
            "type": "string"
          },
          "title": "Job Ids",
          "type": "array"
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "completed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completed At"
        },
        "error_code": {
          "default": "",
          "title": "Error Code",
          "type": "string"
        },
        "error_message": {
          "default": "",
          "title": "Error Message",
          "type": "string"
        },
        "output_asset_ids": {
          "items": {
            "type": "string"
          },
          "title": "Output Asset Ids",
          "type": "array"
        }
      },
      "required": [
        "stage"
      ],
      "title": "WorkflowStageState",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "workspace_id": {
      "title": "Workspace Id",
      "type": "string"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "created_by": {
      "title": "Created By",
      "type": "string"
    },
    "correlation_id": {
      "default": "",
      "title": "Correlation Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/JobStatus",
      "default": "queued"
    },
    "stages": {
      "items": {
        "$ref": "#/$defs/WorkflowStageState"
      },
      "title": "Stages",
      "type": "array"
    },
    "progress_percent": {
      "default": 0,
      "title": "Progress Percent",
      "type": "number"
    },
    "forecast_internal_credits": {
      "default": 0,
      "title": "Forecast Internal Credits",
      "type": "integer"
    },
    "current_stage": {
      "anyOf": [
        {
          "$ref": "#/$defs/WorkflowStage"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "config": {
      "additionalProperties": true,
      "title": "Config",
      "type": "object"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed At"
    },
    "deleted_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Deleted At"
    }
  },
  "required": [
    "id",
    "workspace_id",
    "project_id",
    "created_by",
    "stages"
  ],
  "title": "WorkflowRun",
  "type": "object"
}
