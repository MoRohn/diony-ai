# Python
__pycache__/
*.py[cod]
*$py.class
.Python
.venv/
venv/
.env
.env.local
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/

# Desktop builds: the CURRENT local app for each version is committed
# (dist/desktop/<version>/development/Diony.app or "Diony AI\"), so a clone
# holds a runnable Diony.app. Older builds and release artifacts stay local.
# The per-version development/.gitignore, written by the local build scripts,
# names the one build directory that is kept.
dist/*
!dist/desktop/
dist/desktop/*/*
!dist/desktop/*/development/

# Node (if frontends grow a bundler later)
node_modules/
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# IDEs
.idea/
.vscode/
*.swp

# Local cluster / secrets / weights
infra/local/
*.pem
# the public CA bundle inside the packaged app is not a secret
!**/certifi/cacert.pem
*.key
secrets/
models/
weights/
checkpoints/
*.safetensors
*.gguf

# Runtime data
data/
apps/*/data/
*.db
*.sqlite

# Media vault (NAS mounts, dailies)
vault/
dailies/
masters/
*.mov
*.mxf
*.prores

# Logs
*.log
logs/

# Local agent/session state (recursive: agents drop state beside the code they touch)
.claude/
.benchmarks/

# Local vault runtime state
.diony-vault/
