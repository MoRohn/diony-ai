# Python
__pycache__/
*.py[cod]
*$py.class
.Python
.venv/
venv/
.env
.env.local
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/

# Desktop builds: the current local app is committed as dist/Diony.app (a link
# into dist/builds/<build-id>/) with dist/build.json and dist/current-build.txt,
# so a clone holds a runnable Diony.app. Older builds and the signed release
# artifacts (dist/desktop/<version>/) stay local. dist/builds/.gitignore, written
# by the local build scripts, names the one build directory that is kept.
dist/*
!dist/Diony.app
!dist/build.json
!dist/current-build.txt
!dist/builds/

# Node (if frontends grow a bundler later)
node_modules/
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# IDEs
.idea/
.vscode/
*.swp

# Local cluster / secrets / weights
infra/local/
*.pem
# the public CA bundle inside the packaged app is not a secret
!**/certifi/cacert.pem
*.key
secrets/
models/
weights/
checkpoints/
*.safetensors
*.gguf

# Runtime data
data/
apps/*/data/
*.db
*.sqlite

# Media vault (NAS mounts, dailies)
vault/
dailies/
masters/
*.mov
*.mxf
*.prores

# Logs
*.log
logs/

# Local agent/session state (recursive: agents drop state beside the code they touch)
.claude/
.benchmarks/

# Local vault runtime state
.diony-vault/
